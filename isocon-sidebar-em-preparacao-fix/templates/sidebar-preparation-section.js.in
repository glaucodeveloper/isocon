/*
 * ISOCON — seção “Em preparação”.
 * As rotas abaixo são extraídas automaticamente de const MODULES
 * em interaction-patch.js pelo instalador.
 */

const PREPARATION_ROUTES = __PREPARATION_ROUTES__;

const normalizeHref = (value = "") => {
  const href = String(value || "").trim();
  if (!href) return "";
  return href.startsWith("#") ? href.slice(1).split("?")[0] : href.split("?")[0];
};

function findConfigurationLabel(nav) {
  return [...nav.children].find((element) =>
    element.matches?.(".admin-nav-label")
    && element.textContent.trim().toUpperCase() === "CONFIGURAÇÕES"
  ) || null;
}

function removeOldPreparationMarkers(nav) {
  nav.querySelectorAll(
    ":scope > .admin-implementation-label,"
    + ":scope > .admin-implementation-divider,"
    + ":scope > .admin-preparation-label,"
    + ":scope > .admin-preparation-divider"
  ).forEach((element) => element.remove());
}

function preparationEntries(nav) {
  const routeSet = new Set(PREPARATION_ROUTES);

  return [...nav.querySelectorAll(":scope > a, :scope > button")]
    .filter((element) => {
      const route = normalizeHref(element.getAttribute("href"));
      const text = element.textContent
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();

      return routeSet.has(route)
        || text.includes("em preparacao")
        || element.classList.contains("implementation-module")
        || element.classList.contains("preparation-module");
    });
}

function organizePreparationSection(root = document) {
  const navs = root.matches?.("#adminSidebar nav")
    ? [root]
    : [...(root.querySelectorAll?.("#adminSidebar nav") || [])];

  for (const nav of navs) {
    removeOldPreparationMarkers(nav);

    const entries = preparationEntries(nav);
    if (!entries.length) continue;

    const divider = document.createElement("span");
    divider.className = "admin-preparation-divider";
    divider.setAttribute("aria-hidden", "true");

    const label = document.createElement("span");
    label.className = "admin-nav-label admin-preparation-label";
    label.textContent = "EM PREPARAÇÃO";

    const configuration = findConfigurationLabel(nav);

    if (configuration) {
      nav.insertBefore(divider, configuration);
      nav.insertBefore(label, configuration);

      for (const entry of entries) {
        entry.classList.remove("implementation-module");
        entry.classList.add("preparation-module");
        nav.insertBefore(entry, configuration);
      }
    } else {
      nav.append(divider, label);

      for (const entry of entries) {
        entry.classList.remove("implementation-module");
        entry.classList.add("preparation-module");
        nav.append(entry);
      }
    }
  }
}

const AdminApp = customElements.get("admin-app");
const prototype = AdminApp?.prototype;

if (prototype && !prototype.__isoconPreparationSectionFix) {
  prototype.__isoconPreparationSectionFix = true;

  const previousRenderShell = prototype.renderShell;

  prototype.renderShell = function patchedPreparationSection(current) {
    previousRenderShell.call(this, current);
    organizePreparationSection(this);
  };
}

new MutationObserver((mutations) => {
  const sidebarChanged = mutations.some((mutation) =>
    [...mutation.addedNodes].some((node) =>
      node instanceof Element
      && (
        node.matches?.("#adminSidebar, #adminSidebar nav")
        || node.querySelector?.("#adminSidebar nav")
      )
    )
  );

  if (sidebarChanged) {
    queueMicrotask(() => organizePreparationSection());
  }
}).observe(document.documentElement, {
  childList: true,
  subtree: true,
});

document.addEventListener("DOMContentLoaded", () => {
  organizePreparationSection();
});

organizePreparationSection();
