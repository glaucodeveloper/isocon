/* ISOCON — identidade administrativa institucional e perfil */

/* Login */
.admin-login-eyebrow {
  display: block;
  margin-bottom: 4px;
  color: var(--iso-red);
  font-size: .57rem;
  font-weight: 850;
  letter-spacing: .09em;
}

.admin-login-visual li {
  min-height: 92px;
}

/* Perfil institucional */
.institutional-profile-menu {
  position: relative;
  padding-left: 18px;
  border-left: 1px solid #dde5f0;
}

.institutional-profile-trigger {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) 14px;
  gap: 10px;
  align-items: center;
  min-width: 225px;
  padding: 0;
  color: var(--iso-ink);
  background: transparent;
  border: 0;
  text-align: left;
}

.institutional-profile-avatar {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  color: #fff;
  background: linear-gradient(145deg, var(--iso-navy), var(--iso-blue));
  border-radius: 50%;
  font-size: .63rem;
  font-weight: 900;
  letter-spacing: -.02em;
}

.institutional-profile-copy {
  min-width: 0;
}

.institutional-profile-copy strong,
.institutional-profile-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.institutional-profile-copy strong {
  color: var(--iso-navy);
  font-size: .66rem;
}

.institutional-profile-copy small {
  color: var(--iso-muted);
  font-size: .53rem;
}

.institutional-profile-trigger > i {
  color: #7d899a;
  transition: transform .18s ease;
}

.institutional-profile-trigger[aria-expanded="true"] > i {
  transform: rotate(180deg);
}

.institutional-profile-dropdown {
  position: absolute;
  top: calc(100% + 15px);
  right: 0;
  z-index: 1200;
  width: 270px;
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--iso-line);
  border-radius: 12px;
  box-shadow: 0 22px 55px rgba(5, 28, 65, .2);
}

.institutional-profile-dropdown[hidden] {
  display: none;
}

.institutional-profile-dropdown header {
  display: grid;
  grid-template-columns: 38px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  padding: 16px;
  background: #f5f8fc;
  border-bottom: 1px solid #e2e8f0;
}

.institutional-profile-dropdown header strong,
.institutional-profile-dropdown header small {
  display: block;
}

.institutional-profile-dropdown header strong {
  color: var(--iso-navy);
  font-size: .67rem;
}

.institutional-profile-dropdown header small {
  color: var(--iso-muted);
  font-size: .53rem;
}

.institutional-profile-dropdown > a,
.institutional-profile-dropdown > button {
  display: grid;
  grid-template-columns: 25px 1fr;
  gap: 8px;
  align-items: center;
  width: 100%;
  padding: 12px 16px;
  color: #30425c;
  background: #fff;
  border: 0;
  border-bottom: 1px solid #eef1f5;
  font-size: .63rem;
  font-weight: 750;
  text-align: left;
  text-decoration: none;
}

.institutional-profile-dropdown > a:hover,
.institutional-profile-dropdown > button:hover {
  background: #f3f7fc;
}

.institutional-profile-dropdown > button {
  color: #a32937;
}

.institutional-profile-dropdown > a i,
.institutional-profile-dropdown > button i {
  color: var(--iso-blue);
  font-size: .85rem;
}

.institutional-profile-dropdown > button i {
  color: #c22b3b;
}

/* Estado institucional */
.institutional-publication-status,
.institutional-admin-identity {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) auto;
  gap: 11px;
  align-items: center;
  padding: 14px;
  background: #f3f7fc;
  border-radius: 9px;
}

.institutional-publication-status > i {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  color: var(--iso-blue);
  background: #e6f0ff;
  border-radius: 10px;
  font-size: 1.25rem;
}

.institutional-publication-status strong,
.institutional-publication-status span,
.institutional-admin-identity strong,
.institutional-admin-identity span {
  display: block;
}

.institutional-publication-status strong,
.institutional-admin-identity strong {
  color: var(--iso-navy);
  font-size: .68rem;
}

.institutional-publication-status span,
.institutional-admin-identity span {
  color: var(--iso-muted);
  font-size: .55rem;
}

.institutional-publication-status b,
.institutional-admin-identity b {
  color: #087847;
  font-size: .57rem;
}

.institutional-admin-avatar {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  color: #fff;
  background: linear-gradient(145deg, var(--iso-navy), var(--iso-blue));
  border-radius: 50%;
  font-size: .68rem;
  font-weight: 900;
}

.institutional-session-card .security-note {
  margin: 15px 0;
}

/* Evita reaparecimento de metadados de identidade externa */
.admin-profile {
  display: none !important;
}

@media (max-width: 767.98px) {
  .institutional-profile-trigger {
    min-width: auto;
    grid-template-columns: 36px 14px;
  }

  .institutional-profile-copy {
    display: none;
  }

  .institutional-profile-menu {
    padding-left: 12px;
  }

  .institutional-profile-dropdown {
    position: fixed;
    top: 68px;
    right: 12px;
    width: min(300px, calc(100vw - 24px));
  }
}
