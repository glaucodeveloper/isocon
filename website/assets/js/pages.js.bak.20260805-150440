/*
 * Resolve mídia a partir da localização real deste módulo.
 * pages.js está em website/assets/js/. Subindo dois níveis,
 * chegamos à raiz pública de website/.
 */
const publicRootUrl = new URL("../../", import.meta.url);

const publicMediaUrl = (value = "") => {
  const source = String(value || "").trim();
  if (!source) return "";

  if (/^(?:data:|blob:|https?:\/\/)/i.test(source)) return source;

  const normalized = source
    .replaceAll("\\", "/")
    .replace(/^\.?\//, "")
    .replace(/^website\//, "");

  return new URL(normalized, publicRootUrl).href;
};

const cssBackgroundUrl = (value = "") => {
  const resolved = publicMediaUrl(value)
    .replaceAll("\\", "\\\\")
    .replaceAll('"', '\\"');

  return `url("${resolved}")`;
};
const mountCards = (selector, tagName, entries) => {
  queueMicrotask(() => document.querySelectorAll(selector).forEach((container, index) => {
    const card = document.createElement(tagName);
    card.data = entries[index];
    container.replaceChildren(card);
  }));
};
const breadcrumbs = (entries) => `<nav class="breadcrumbs">${entries.map((entry, index) =>
  index === entries.length - 1
    ? `<span>${esc(entry.label)}</span>`
    : `<a href="#${entry.path}">${esc(entry.label)}</a><i class="bi bi-chevron-right"></i>`
).join("")}</nav>`;

