function filteredItems(lineId) {
  const params = queryParams();
  const search = (params.get("q") || "").toLowerCase();
  const status = params.get("status") || "";
  const category = params.get("category") || "";
  let items = state.data.items.filter((item) => item.lineId === lineId && item.publicationStatus === "publicado");
  if (search) items = items.filter((item) => `${item.name} ${item.code} ${item.shortDescription}`.toLowerCase().includes(search));
  if (status) items = items.filter((item) => item.status === status);
  if (category) items = items.filter((item) => item.category === category);
  return items;
}

