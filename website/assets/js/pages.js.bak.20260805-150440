export function bindPublicPage(root) {
  root.querySelectorAll("[data-add-direct]").forEach((button) => button.addEventListener("click", () => {
    addToQuote(button.dataset.addDirect);
    button.innerHTML = '<i class="bi bi-check-lg me-2"></i>Adicionado à solicitação';
  }));
  root.querySelectorAll("[data-gallery-thumb]").forEach((button) => button.addEventListener("click", () => {
    root.querySelectorAll("[data-gallery-thumb]").forEach((entry) => entry.classList.remove("active"));
    button.classList.add("active");
    const image = root.querySelector("#itemMainImage");
    if (image) image.src = button.dataset.galleryThumb;
  }));
  root.querySelector("#lineFilters")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = new FormData(event.currentTarget);
    const params = new URLSearchParams();
    for (const [key, value] of form.entries()) if (String(value).trim()) params.set(key, value);
    const path = location.hash.split("?")[0];
    location.hash = `${path}${params.size ? `?${params}` : ""}`;
  });
  root.querySelector("#contactForm")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = new FormData(event.currentTarget);
    const body = [
      `Nome: ${form.get("name")}`,
      `Empresa: ${form.get("company")}`,
      `E-mail: ${form.get("email")}`,
      `Telefone: ${form.get("phone")}`,
      `Assunto: ${form.get("subject")}`,
      "",
      form.get("message"),
    ].join("\n");
    location.href = `mailto:${state.data.site.email}?subject=${encodeURIComponent(`Contato pelo site: ${form.get("subject")}`)}&body=${encodeURIComponent(body)}`;
  });
  root.querySelectorAll("[data-remove-quote]").forEach((button) => button.addEventListener("click", () => {
    removeFromQuote(button.dataset.removeQuote);
    location.hash = "/solicitacao";
    document.dispatchEvent(new Event("hashchange"));
  }));
  root.querySelectorAll("[data-quote-quantity]").forEach((field) => field.addEventListener("change", () => {
    updateQuote(field.dataset.quoteQuantity, { quantity: Math.max(1, Number(field.value) || 1) });
  }));
  root.querySelectorAll("[data-quote-note]").forEach((field) => field.addEventListener("input", () => {
    updateQuote(field.dataset.quoteNote, { note: field.value });
  }));
  root.querySelector("#quoteForm")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = new FormData(event.currentTarget);
    const itemLines = state.quote.map((entry) => {
      const item = findItem(entry.id);
      return item ? `• ${item.name} (${item.code}) — quantidade estimada: ${entry.quantity}${entry.note ? ` — ${entry.note}` : ""}` : "";
    }).filter(Boolean).join("\n");
    const message = [
      "Olá, gostaria de iniciar um atendimento comercial com a ISOCON.",
      "",
      `Responsável: ${form.get("name")}`,
      `Empresa / CNPJ: ${form.get("company") || "não informado"}`,
      `Telefone: ${form.get("phone")}`,
      `E-mail: ${form.get("email") || "não informado"}`,
      `Destino: ${form.get("city") || "não informado"} / ${form.get("state") || ""}`,
      `Canal preferido: ${form.get("channel")}`,
      "",
      "Itens de interesse:",
      itemLines,
      "",
      `Contexto: ${form.get("message") || "não informado"}`,
    ].join("\n");
    window.open(whatsappUrl(message), "_blank", "noopener");
  });
}
