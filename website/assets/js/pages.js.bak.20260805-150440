export function searchPage() {
  const q = (queryParams().get("q") || "").trim();
  const needle = q.toLowerCase();
  const segments = state.data.segments.filter((entry) => `${entry.name} ${entry.description} ${entry.examples.join(" ")}`.toLowerCase().includes(needle));
  const lines = state.data.lines.filter((entry) => `${entry.name} ${entry.description} ${entry.examples.join(" ")}`.toLowerCase().includes(needle));
  const items = state.data.items.filter((entry) => entry.publicationStatus === "publicado" && `${entry.name} ${entry.code} ${entry.shortDescription} ${entry.category}`.toLowerCase().includes(needle));
  mountCards("[data-search-segment]", "segment-card", segments);
  mountCards("[data-search-line]", "line-card", lines);
  mountCards("[data-search-item]", "item-card", items);
  return template`
  <section class="search-results section-pad"><div class="container-fluid site-container">
    ${breadcrumbs([{path:"/",label:"Início"},{label:"Busca"}])}
    <div class="search-title"><h1>Resultados para “${esc(q)}”</h1><p>${segments.length + lines.length + items.length} resultado(s) encontrados.</p></div>
    ${segments.length ? `<section><h2>Segmentos</h2><div class="row g-3">${segments.map(() => `<div class="col-md-6 col-xl-4" data-search-segment></div>`).join("")}</div></section>` : ""}
    ${lines.length ? `<section><h2>Linhas de produtos</h2><div class="row g-3">${lines.map(() => `<div class="col-md-6 col-xl-4" data-search-line></div>`).join("")}</div></section>` : ""}
    ${items.length ? `<section><h2>Itens</h2><div class="row g-3">${items.map(() => `<div class="col-md-6 col-xl-3" data-search-item></div>`).join("")}</div></section>` : ""}
    ${!segments.length && !lines.length && !items.length ? supportCta("Nenhum resultado encontrado", "Envie a necessidade para que a equipe procure uma alternativa.") : ""}
  </div></section>`;
}

